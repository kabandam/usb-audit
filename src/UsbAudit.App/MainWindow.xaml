<Window x:Class="UsbAudit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Console"
        Width="1040" Height="690" MinWidth="900" MinHeight="560"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Enterprise sidebar -->
        <Border Grid.Column="0" Background="#101828">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="#175CD3" CornerRadius="8">
                            <TextBlock Text="S" Foreground="White" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Smart Console" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="CRECCOM Endpoint" Foreground="#98A2B3" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="#1D2939" CornerRadius="7" Margin="0,22,0,0" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="#53B1FD" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="Overview" Foreground="White" FontWeight="SemiBold" Margin="9,0,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="2,22,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="APPLICATIONS RECEIVED" Foreground="#98A2B3" FontSize="10" FontWeight="SemiBold"/>
                    <Border Grid.Column="1" Background="#344054" CornerRadius="9" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock x:Name="ReceivedAppsCountText" Text="0" Foreground="#D0D5DD" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="ReceivedAppsEmptyText"
                                       Text="No applications have been received yet."
                                       Foreground="#667085" FontSize="11" TextWrapping="Wrap"
                                       Margin="4,8,4,0"/>
                            <ItemsControl x:Name="ReceivedAppsSidebarList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1D2939" CornerRadius="7" Padding="9" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" Background="#344054" CornerRadius="6" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding AppName}" Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Version}" Foreground="#98A2B3" FontSize="10"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="#D0D5DD" FontSize="10" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="4" BorderBrush="#344054" BorderThickness="0,1,0,0" Padding="2,13,2,0" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SidebarComputerText" Text="Managed endpoint" Foreground="#EAECF0"
                                   FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SidebarVersionText" Text="Smart Console" Foreground="#667085"
                                   FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#EAECF0" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Endpoint overview" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Monitoring, deployments and connected devices" Foreground="#667085" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="AgentBadge" Background="#FEF3F2" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AgentDot" Width="8" Height="8" Fill="#F04438" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AgentStatusText" Text="Checking agent" Margin="7,0,0,0" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Connected USBs" Foreground="#667085" FontSize="12"/>
                                <TextBlock x:Name="UsbCountText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Cloud status" Foreground="#667085" FontSize="12"/>
                                <TextBlock x:Name="CloudStateText" Text="Not configured" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Queued events" Foreground="#667085" FontSize="12"/>
                                <TextBlock x:Name="PendingEventsText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Last cloud sync" Foreground="#667085" FontSize="12"/>
                                <TextBlock x:Name="LastSyncText" Text="Never" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#EFF8FF" BorderBrush="#B2DDFF" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Latest activity" Foreground="#175CD3" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LastActivityText" Text="Waiting for USB activity" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock x:Name="LastActivityTimeText" Foreground="#667085" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Refresh" Click="Refresh_Click" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,8">
                        <TextBlock Text="Application deployments" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeploymentListHint" HorizontalAlignment="Right" Foreground="#667085" FontSize="11" Text="No applications waiting"/>
                    </Grid>

                    <ItemsControl x:Name="PendingDeploymentsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="#EFF8FF" CornerRadius="8" VerticalAlignment="Center">
                                            <TextBlock Text="↓" Foreground="#175CD3" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#175CD3" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#667085" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource PrimaryButton}"
                                                Content="{Binding ActionLabel}"
                                                Tag="{Binding CommandId}"
                                                IsEnabled="{Binding CanInstall}"
                                                Click="InstallPendingDeployment_Click"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,18,0,8">
                        <TextBlock Text="Connected devices" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeviceListHint" HorizontalAlignment="Right" Foreground="#667085" FontSize="11" Text="No USB storage connected"/>
                    </Grid>

                    <ItemsControl x:Name="ConnectedDevicesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="32" Background="#F2F4F7" CornerRadius="7" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DriveLetter}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#667085" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Connected}" Foreground="#667085" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Expander Header="Connection settings" Margin="0,12,0,0">
                        <Border Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="CloudEnabledCheckBox" Content="Send audit metadata to the web console" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Ingest API URL" FontWeight="Medium"/>
                                <TextBox x:Name="CloudApiTextBox" Margin="0,5,0,11"/>
                                <TextBlock Text="Web console URL" FontWeight="Medium"/>
                                <TextBox x:Name="WebConsoleTextBox" Margin="0,5,0,11"/>
                                <TextBlock Text="Terminal enrollment token" FontWeight="Medium"/>
                                <PasswordBox x:Name="TerminalTokenBox" Padding="12,10" BorderBrush="#D0D5DD" BorderThickness="1" Margin="0,5,0,12"/>
                                <TextBlock x:Name="SettingsMessage" Foreground="#667085" TextWrapping="Wrap" Margin="0,0,0,11"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Save connection" Click="SaveConnection_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Open web console" Click="OpenWebConsole_Click" Margin="9,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Border BorderBrush="#EAECF0" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,15,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TerminalIdText" Foreground="#667085" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="VersionText" Foreground="#98A2B3" FontSize="11" Margin="0,3,0,0"/>
                                <TextBlock x:Name="UpdateStatusText" Foreground="#667085" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="CheckUpdatesButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Check updates" Click="CheckUpdates_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
